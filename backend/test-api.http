@baseUrl = http://localhost:5000/api
@token = YOUR_JWT_TOKEN

### ==========================================
### AUTH
### ==========================================

### Register User
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Piyush",
  "email": "piyush@example.com",
  "password": "Password123"
}


### Login User
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "piyush@example.com",
  "password": "Password123"
}


### Logout User
POST {{baseUrl}}/auth/logout
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOjEsImVtYWlsIjoicGl5dXNoQGV4YW1wbGUuY29tIiwiaWF0IjoxNzkxNDAzMjI0LCJleHAiOjE3OTE0ODk2MjR9.ubmNJk_gAJSL8c9IOXy6xT2F6N1KD4x75CJV8CglumU

